# Appwrite Cloud or Self-hosted Configuration
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_appwrite_project_id
APPWRITE_API_KEY=script_only_secret_never_expose_in_browser
NEXT_PUBLIC_APPWRITE_DATABASE_ID=bluecred-db
NEXT_PUBLIC_APPWRITE_PROJECTS_COLLECTION_ID=projects
NEXT_PUBLIC_APPWRITE_TRANSACTIONS_COLLECTION_ID=transactions
NEXT_PUBLIC_APPWRITE_BUCKET_ID=project-images

# Web3 / RPC Providers
NEXT_PUBLIC_SEPOLIA_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id


# Local-only ML service
BLUECRED_ML_ENABLED=false
BLUECRED_ML_TOKEN=replace_with_a_local_random_token
NEXT_PUBLIC_AMOY_RPC_URL=http://127.0.0.1:8545

# Disabled by default; never enable mainnet writes
NEXT_PUBLIC_ENABLE_TESTNET_WRITES=false
